<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wmm.eldercare.core.mapper.RefreshTokenMapper">

    <insert id="saveRefreshToken" parameterType="com.wmm.eldercare.core.pojo.RefreshToken" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO refresh_token (user_id, token, expire_time, create_time)
        VALUES (#{userId}, #{token}, #{expireTime}, #{createTime})
    </insert>

    <select id="findByToken" resultType="com.wmm.eldercare.core.pojo.RefreshToken">
        SELECT id, user_id, token, expire_time, create_time
        FROM refresh_token
        WHERE token = #{token}
    </select>

    <delete id="deleteByToken">
        DELETE FROM refresh_token WHERE token = #{token}
    </delete>

    <delete id="deleteByUserId">
        DELETE FROM refresh_token WHERE user_id = #{userId}
    </delete>

</mapper>